# Copy to .env and fill in real values. .env is gitignored.
# docker-compose.yaml reads .env automatically; demo scripts `source` it.

# Absolute path of this project ON THE DOCKER DAEMON HOST (bind mounts are
# resolved by the daemon, so they must use the host path).
PH_HOST_DIR=/path/on/daemon/host/price_hunter
# Release keystore dir (receipt_tools-release.jks + storepass.txt), OUTSIDE the repo.
PH_KEYSTORE_DIR=/path/to/keystores

# Database
PH_DB_USER=change-me
PH_DB_PASSWORD=change-me
PH_DB_NAME=change-me
# Direct DSN for the PRODUCTION Postgres (demo/ maintenance scripts)
PH_PROD_DB_DSN=postgresql://USER:PASSWORD@PROD_HOST:5432/DBNAME

# LLM endpoints (OpenAI-compatible)
PH_VL_BASE_URL=http://LLM_HOST:8080/v1
PH_VL_MODEL=model-name
PH_TEXT_BASE_URL=http://LLM_HOST:8080/v1
PH_TEXT_MODEL=model-name
